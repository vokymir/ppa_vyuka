    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="strana" type="Real" array="False" size=""/>
            <declare name="uhlopricka" type="Real" array="False" size=""/>
            <input variable="strana"/>
            <assign variable="uhlopricka" expression="strana * sqrt(2)"/>
            <output expression="&quot;Ctverec o strane &quot; &amp; strana &amp; &quot; ma uhlopricku delky &quot; &amp; ToFixed(uhlopricka, 3) &amp;&quot;.&quot;" newline="True"/>
        </body>
    </function>
