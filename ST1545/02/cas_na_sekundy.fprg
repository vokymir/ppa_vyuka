    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="mins, secs, totalsecs" type="Integer" array="False" size=""/>
            <output expression="&quot;Zadej minuty:&quot;" newline="True"/>
            <input variable="mins"/>
            <output expression="&quot;Zadej sekundy:&quot;" newline="True"/>
            <input variable="secs"/>
            <assign variable="totalsecs" expression="mins * 60 + secs"/>
            <output expression="&quot;To je celkem &quot; &amp; totalsecs &amp; &quot; sekund!&quot;" newline="True"/>
        </body>
    </function>
