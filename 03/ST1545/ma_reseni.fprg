<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ma_reseni"/>
        <attribute name="authors" value="javok"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 05:10:18 odp."/>
        <attribute name="created" value="amF2b2s7VUMzMTFQMTctS0lWOzIwMjYtMTAtMDc7MDU6MDY6MzAgb2RwLjsyNzkx"/>
        <attribute name="edited" value="amF2b2s7VUMzMTFQMTctS0lWOzIwMjYtMTAtMDc7MDU6MTA6MTggb2RwLjsxOzI5MDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, D" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <assign variable="D" expression="b * b - 4 * a * c"/>
            <if expression="D &gt;= 0">
                <then>
                    <output expression="&quot;ma reseni&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;nema reseni&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
