    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="cislo" type="Real" array="False" size=""/>
            <input variable="cislo"/>
            <if expression="cislo &gt;= 0">
                <then>
                    <output expression="&quot;to je kladne&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;je to zaporne&quot;" newline="True"/>
                </else>
            </if>
        </body>
