    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2" type="Integer" array="False" size=""/>
            <input variable="n1"/>
            <input variable="n2"/>
            <if expression="n1 &gt; n2">
                <then>
                    <output expression="n1" newline="True"/>
                </then>
                <else>
                    <if expression="n1 == n2">
                        <then>
                            <output expression="&quot;sou stejny&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="n2" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
