    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2, n3, max" type="Integer" array="False" size=""/>
            <input variable="n1"/>
            <input variable="n2"/>
            <input variable="n3"/>
            <assign variable="max" expression="n1"/>
            <if expression="max &gt; n2">
                <then/>
                <else>
                    <assign variable="max" expression="n2"/>
                </else>
            </if>
            <if expression="max &gt; n3">
                <then/>
                <else>
                    <assign variable="max" expression="n3"/>
                </else>
            </if>
            <output expression="max" newline="True"/>
        </body>
    </function>
</flowgorithm>
