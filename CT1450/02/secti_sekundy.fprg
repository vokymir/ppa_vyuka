    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="minuty, sekundy, celkemsekund" type="Integer" array="False" size=""/>
            <input variable="minuty"/>
            <input variable="sekundy"/>
            <assign variable="celkemsekund" expression="sekundy + minuty * 60"/>
            <output expression="&quot;toto je dohromady &quot; &amp; celkemsekund &amp; &quot; sekund&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
