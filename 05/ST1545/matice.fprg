<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="matice"/>
        <attribute name="authors" value="javok"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-21 04:43:26 odp."/>
        <attribute name="created" value="amF2b2s7VUMzMTFQMTctS0lWOzIwMjYtMTAtMjE7MDQ6MzA6Mzggb2RwLjsyNzkx"/>
        <attribute name="edited" value="amF2b2s7VUMzMTFQMTctS0lWOzIwMjYtMTAtMjE7MDQ6NDM6MjYgb2RwLjsyOzI5MDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, j" type="Integer" array="False" size=""/>
            <input variable="n"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <for variable="j" start="1" end="n" direction="inc" step="1">
                    <if expression="n - i + 1 == j || i == j">
                        <then>
                            <if expression="n - i + 1 == j &amp;&amp; i == j">
                                <then>
                                    <output expression="&quot;2&quot;" newline="False"/>
                                </then>
                                <else>
                                    <output expression="&quot;1&quot;" newline="False"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;0&quot;" newline="False"/>
                        </else>
                    </if>
                    <output expression="&quot; &quot;" newline="False"/>
                </for>
                <output expression="&quot;&quot;" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
