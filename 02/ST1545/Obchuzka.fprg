        <attribute name="edited" value="amF2b2s7VUMzMTFQMTctS0lWOzIwMjYtMDktMzA7MDU6MTk6MDIgb2RwLjsxOzI5MDY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="posA" type="Real" array="False" size=""/>
            <declare name="posB" type="Real" array="False" size=""/>
            <declare name="length" type="Real" array="False" size=""/>
            <declare name="rot" type="Real" array="False" size=""/>
            <declare name="rad" type="Real" array="False" size=""/>
            <input variable="posA"/>
            <input variable="posB"/>
            <input variable="length"/>
            <input variable="rot"/>
            <assign variable="rad" expression="rot*(3.14159265359/180)"/>
            <output expression="&quot;polygon((&quot; &amp; ToFixed((posA),2) &amp; &quot;,&quot; &amp; ToFixed((posB),2) &amp; &quot;),(&quot; &amp; ToFixed((posA + length*Cos(rad)),2) &amp; &quot;,&quot; &amp; ToFixed((posB + length*Sin(rad)),2) &amp; &quot;),(&quot; &amp; ToFixed((posA + length*(Cos(rad)-Sin(rad))),2) &amp; &quot;,&quot; &amp; ToFixed((posB + length*(Sin(rad)+Cos(rad))),2) &amp; &quot;),(&quot; &amp; ToFixed((posA-length*Sin(rad)),2) &amp; &quot;,&quot; &amp; ToFixed((posB + length*Cos(rad)),2) &amp; &quot;))&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
